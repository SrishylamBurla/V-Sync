PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional origins, including production/preview domains.
CORS_ALLOWED_ORIGINS=https://v-sync.in,https://www.v-sync.in
# On managed platforms behind one reverse proxy, TRUST_PROXY=1 is usually appropriate.
# TRUST_PROXY=1
MONGODB_URI=mongodb://127.0.0.1:27017/vsync
# Use long, random, distinct secrets (at least 32 characters each).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Optional only when the host DNS cannot resolve MongoDB Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
